{
	"name": "@devshedlabs/csvx-ts",
	"version": "0.1.11",
	"description": "TypeScript engine for the CSVX specification: load, represent, edit, and write CSVX workbooks as data structures. No CLI \u2014 see csvx-cli for that.",
	"type": "module",
	"main": "./dist/cjs/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/cjs/index.js"
			}
		},
		"./browser": {
			"import": {
				"types": "./dist/browser.d.ts",
				"default": "./dist/browser.js"
			},
			"require": {
				"types": "./dist/cjs/browser.d.ts",
				"default": "./dist/cjs/browser.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
		"prepare": "npm run build",
		"test": "vitest run",
		"codegen": "csvx codegen --lang ts --schema-dir ../csvx-spec/schemas --out src/schema/generated.ts",
		"check": "node scripts/check-version.mjs && tsc --noEmit && vitest run",
		"prepublishOnly": "npm run check"
	},
	"dependencies": {
		"decimal.js": "^10.6.0",
		"jszip": "^3.10.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.1",
		"typescript": "^5.7.2",
		"vitest": "^5.0.2"
	},
	"engines": {
		"node": ">=18"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevShedLabs/csvx-ts.git"
	},
	"homepage": "https://github.com/DevShedLabs/csvx-ts#readme",
	"bugs": {
		"url": "https://github.com/DevShedLabs/csvx-ts/issues"
	},
	"keywords": [
		"csvx",
		"spreadsheet",
		"csv",
		"formulas",
		"workbook"
	],
	"publishConfig": {
		"access": "public"
	},
	"module": "./dist/index.js"
}
